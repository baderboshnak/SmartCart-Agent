{
  "name": "smartcart",
  "version": "2.0.0",
  "private": true,
  "description": "SmartCart: an AI grocery shopping agent for Israeli supermarkets (Next.js, Gemini function calling, MongoDB Atlas).",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:engine && npm run test:unit",
    "test:engine": "node --test tests/engine/*.test.mjs",
    "test:unit": "node --import tsx --test \"tests/unit/**/*.test.ts\" \"tests/agent/**/*.test.ts\"",
    "test:db": "node --import tsx --test --test-concurrency=1 \"tests/database/**/*.test.ts\" \"tests/integration/**/*.test.ts\"",
    "test:e2e": "node --import tsx --test --test-concurrency=1 \"tests/e2e/**/*.test.ts\"",
    "test:all": "npm test && npm run test:db",
    "test:all:offline": "node --preserve-symlinks --preserve-symlinks-main --import ./tests/evaluation/offline-guard.mjs --import tsx tests/evaluation/run.ts all",
    "test:scenarios": "npm run --silent test:eval -- scenarios",
    "test:retrieval": "npm run --silent test:eval -- retrieval",
    "test:matching": "npm run --silent test:eval -- matching",
    "test:validation": "npm run --silent test:eval -- validation",
    "test:cache": "npm run --silent test:eval -- cache",
    "test:optimizer": "npm run --silent test:eval -- optimizer",
    "test:failures": "npm run --silent test:eval -- failures",
    "test:voice": "npm run --silent test:eval -- voice",
    "test:response": "npm run --silent test:eval -- response",
    "test:performance": "npm run --silent test:eval -- performance",
    "test:replay": "npm run --silent test:eval -- replay",
    "test:report": "npm run --silent test:eval -- report",
    "test:eval": "node --preserve-symlinks --preserve-symlinks-main --import ./tests/evaluation/offline-guard.mjs --import tsx tests/evaluation/run.ts",
    "test:live:budgeted": "node --preserve-symlinks --preserve-symlinks-main --import tsx tests/evaluation/live-budget.mjs",
    "test:live:approved": "node --preserve-symlinks --preserve-symlinks-main --env-file=.env --import tsx tests/evaluation/approved-campaign.ts",
    "test:live:scenarios": "node --preserve-symlinks --preserve-symlinks-main --import tsx tests/evaluation/live-agent-scenarios.ts",
    "db:indexes": "tsx scripts/create-indexes.ts",
    "db:migrate": "tsx scripts/migrate-products.ts",
    "db:verify": "tsx scripts/verify-migration.ts",
    "catalog:audit": "tsx scripts/audit-catalog.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "test:live": "node engine/smartcart-live-qa.mjs",
    "test:live:agent": "tsx scripts/live-agent-smoke.ts",
    "test:live:matching": "tsx scripts/live-semantic-matching.ts"
  },
  "dependencies": {
    "@google/genai": "3.6.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.68.0",
    "mongodb": "7.9.0",
    "next": "16.4.5",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3"
  }
}
