# Copy to .env and fill in real values. Never commit .env.
# All variables are server-side only; none are exposed to the browser.

# MongoDB Atlas connection string. Use a database user with readWrite on MONGODB_DB_NAME.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=smartcart
MONGODB_DB_NAME=smartcart

# Google Gemini API key (https://aistudio.google.com/apikey).
GEMINI_API_KEY=

# One generateContent model for the shopping agent, product checks, and file-based CLI.
GEMINI_MODEL=gemini-3.5-flash-lite

# Gemini Live model for real-time voice.
GEMINI_LIVE_MODEL=gemini-3.8-live

# Optional: most product-checking calls to Gemini at the same time for the whole server
# (1 to 64, default 12). Each cart is also limited to 12 at a time.
# SMARTCART_MATCH_CONCURRENCY=12

# Optional: agent and Gemini Live trace detail. Defaults to 1 in development and 0 in production.
# 0 shows short terminal summaries. 1 shows timed details and previews long blocks in the terminal.
# full includes untruncated blocks, low-level events, and Gemini instructions.
# Detailed traces may include customer messages, transcripts, model replies, and tool inputs and results.
# SMARTCART_DEBUG=1
