# Copy to .env and fill in real values. Never commit .env.
# All variables are server-side only; none are exposed to the browser.

# MongoDB Atlas connection string. Use a database user with readWrite on MONGODB_DB_NAME.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=smartcart
MONGODB_DB_NAME=smartcart

# Google Gemini API key (https://aistudio.google.com/apikey).
GEMINI_API_KEY=

# Main agent model (generateContent with function calling).
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional: agent backups, tried in order when the main model is busy, slow or missing ("" = none).
# GEMINI_BACKUP_MODELS=gemini-3.6-flash,gemma-4-26b-a4b-it,gemini-3.8-flash,gemma-4-31b-it,gemini-4-hydrogen

# Gemini Live model: the website voice feature (listens and speaks) and the legacy CLI in engine/.
GEMINI_LIVE_MODEL=gemini-3.8-live

# Optional: product-checking models; calls are spread evenly across them.
# SMARTCART_MATCH_MODEL=gemini-3.1-flash-lite,gemini-3.5-flash-lite
# Optional: checking backups, used only when every checking model is busy ("" = none).
# SMARTCART_MATCH_BACKUP_MODELS=gemini-3.6-flash,gemini-3.8-flash,gemma-4-31b-it,gemini-4-hydrogen

# Optional: most product-checking calls to Gemini at the same time for the whole server
# (1 to 64, default 12). Each cart is also limited to 12 at a time.
# SMARTCART_MATCH_CONCURRENCY=12
